# Database
DB_URL=jdbc:postgresql://postgres:5432/bnc
DB_USERNAME=
DB_PASSWORD=

# File Upload Paths
FILE_ROOT_PATH=/app/resources
FILE_DOWNLOAD_PATH=/app

# Naver / Kakao OAuth
#
# 값을 비워두면 소셜 로그인이 비활성화된다 (로그인 화면에서 버튼이 숨겨지고 콜백 URL도 막힘).
# 나중에 사용하려면 아래 세 단계만 하면 되고, 코드 수정은 필요 없다.
#   1. 네이버/카카오 개발자 콘솔에서 앱 등록 후 키 발급
#   2. 콘솔의 Callback URL을 아래 REDIRECT_URI와 똑같이 등록
#   3. 여기에 값을 채우고 `docker compose up -d --force-recreate bnc-app`
#
# 제공자별로 독립이므로 한쪽만 켜도 된다.
# (네이버는 CLIENT_ID/SECRET/REDIRECT_URI 3개, 카카오는 CLIENT_ID/REDIRECT_URI 2개가 모두 필요)

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost/auth/naverLogin

KAKAO_CLIENT_ID=
KAKAO_REDIRECT_URI=http://localhost/auth/kakaoLogin

# Gmail SMTP (앱 비밀번호 사용)
MAIL_USERNAME=
MAIL_PASSWORD=
